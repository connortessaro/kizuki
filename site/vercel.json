{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd .. && npx --yes pnpm@10.34.6 install --frozen-lockfile --ignore-scripts",
  "buildCommand": "cd .. && npx --yes pnpm@10.34.6 docs:site && rm -rf site/docs && cp -R docs/api site/docs",
  "outputDirectory": ".",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ../lib ../tui ../docs ../scripts ../typedoc.json ../package.json ../pnpm-lock.yaml ../pnpm-workspace.yaml",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
