{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd .. && npm ci --ignore-scripts --no-audit --no-fund",
  "buildCommand": "cd .. && npm run docs:site && rm -rf site/docs && cp -R docs/api site/docs",
  "outputDirectory": ".",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ../lib ../workflows ../app ../proxy.ts ../next.config.ts ../bin/cli.d.mts ../docs ../scripts ../typedoc.json ../package.json ../package-lock.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
