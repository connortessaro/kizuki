#!/usr/bin/env node
// sync
import { spawn } from "node:child_process";
import { fileURLToPath } from "node:url";
import { dirname } from "node:path";
import { runSync } from "./lib/run.mjs";

const vaultDir = dirname(fileURLToPath(import.meta.url));

function runCodex(prompt) {
  return new Promise((resolve, reject) => {
    const child = spawn("codex", ["exec", prompt], { stdio: ["ignore", "pipe", "inherit"] });
    let out = "";
    child.stdout.on("data", (d) => (out += d));
    child.on("error", reject);
    child.on("close", (code) => (code === 0 ? resolve(out) : reject(new Error(`codex exited with ${code}`))));
  });
}

runSync({ argv: process.argv.slice(2), vaultDir, runCodex })
  .then((r) => {
    const who = r.scope.kind === "person" ? r.scope.name : "all";
    console.log(`OrgMind sync — scope: ${who}, sources: ${r.sources.join(",")}${r.dryRun ? " (dry-run)" : ""}`);
    if (!r.changes.length) console.log("  no changes");
    for (const c of r.changes) console.log(`  updated ${c.path}`);
  })
  .catch((e) => {
    console.error(`sync failed: ${e.message}`);
    process.exit(1);
  });
