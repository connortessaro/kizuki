#!/usr/bin/env node
// kizuki
import { fileURLToPath } from "node:url";
import { dirname, join, resolve } from "node:path";
import { appendFile, mkdir } from "node:fs/promises";
import { runSync } from "./lib/run.mjs";
import { runCheck, formatContradictions, makeRunCheckAgent, parseCheckArgs } from "./lib/check.mjs";
import { resolveAgent, makeConfiguredRunAgent } from "./lib/agent.mjs";
import { readShift, startShift, endShift, recordStop, renderBrief, writeDaySummary } from "./lib/shift.mjs";
import { installJob, removeJob } from "./lib/launchd.mjs";
import { runDoctor } from "./lib/doctor.mjs";
import { recordSyncFailure, recordSyncSuccess } from "./lib/syncFailures.mjs";
import { notifySyncFailing } from "./lib/notify.mjs";
import { runInit, formatInitReport } from "./lib/init.mjs";
import { watchTranscripts } from "./lib/watcher.mjs";
import { runSignalCommand, runSignalsCommand } from "./lib/signalCommands.mjs";
import { runInsightCommand, runInsightsCommand } from "./lib/insightCommands.mjs";
import { runCatchCommand, runCatchesCommand } from "./lib/catchCommands.mjs";
import { runGateCommand } from "./lib/gateCommands.mjs";
import { runSkillsCommand } from "./lib/skills.mjs";
import { runCaptureCommand } from "./lib/captureCommands.mjs";
import { runDaemonCommand } from "./lib/daemonCommands.mjs";

const repoDir = dirname(fileURLToPath(import.meta.url));
const vaultDir = process.env.KIZUKI_VAULT ? resolve(process.env.KIZUKI_VAULT) : repoDir;
const kizukiPath = join(repoDir, "kizuki");
const [command, ...rest] = process.argv.slice(2);

const USAGE = `usage: kizuki <command>
  kizuki init [--force-config] [--agent codex|claude|gemini|opencode|http]   create vault dirs + default config
  kizuki sync [person] [--project p] [--team t] [--source a,b] [--dry-run]
  kizuki sync --loop                               background mode (no-op unless a shift is on)
  kizuki watch                                     watch transcripts/ and sync on new files
  kizuki start                                     begin shift: sync + brief + 30-min background sync
  kizuki stop                                      end shift: final sync + day summary + remove background sync
  kizuki doctor [--no-smoke] [--check-only]        diagnose config, agent, vault structure
  kizuki signals [--status active|open|acted|dismissed|resolved|all] [--json]
  kizuki signals migrate-alerts [--dry-run]
  kizuki signal show <id> [--json]
  kizuki signal act <id> [--note <text>]
  kizuki signal dismiss <id> --reason <reason> [--note <text>]
  kizuki signal resolve <id> [--note <text>]
  kizuki insights [--status active|archived|all] [--json]
  kizuki insight show <id> [--json]
  kizuki insight archive <id> [--note <text>]
  kizuki catch "<note>" [--signal <id>] [--insight <id>]   record a true catch (gate evidence)
  kizuki catches [--json]                          list recorded catches
  kizuki gate [--weeks n] [--json]                 weekly gate-evidence report
  kizuki skills export [--agent claude|codex|cursor|gemini|generic|all] [--check] [--dist]   install ritual skills
  kizuki check "<draft>" [--person p] [--project p] [--team t] [--json]   flag where a draft contradicts the vault (read-only)
  kizuki daemon install|uninstall|restart|status|run       manage the local authenticated API daemon
  kizuki capture "<text>" [--kind note|correction|decision|hypothesis|question]
    [--person <name> | --project <name> | --team <name>]  record a private local capture`;

async function readStdin() {
  const chunks = [];
  for await (const chunk of process.stdin) chunks.push(chunk);
  return Buffer.concat(chunks).toString("utf8");
}

function scopeLabel(scope) {
  if (scope.kind === "all") return "all";
  return `${scope.kind}/${scope.name}`;
}

async function doSync(argv) {
  const resolved = await resolveAgent(vaultDir);
  const r = await runSync({ argv, vaultDir, runAgent: makeConfiguredRunAgent(resolved), agentKind: resolved.kind });
  await recordSyncSuccess(vaultDir);
  console.log(`Kizuki sync — scope: ${scopeLabel(r.scope)}, sources: ${r.sources.join(",")}${r.dryRun ? " (dry-run)" : ""}`);
  if (!r.changes.length && !r.newAlerts.length) console.log("  no changes");
  if (!r.newAlerts.length) console.log("  no signals");
  for (const warning of r.warnings) console.warn(`  warning: ${warning}`);
  for (const c of r.changes) console.log(`  updated ${c.path}`);
  for (const a of r.newAlerts) console.log(`  alert [${a.severity}] ${a.kind} ${a.type}/${a.name}`);
}

try {
  if (command === "sync" && rest.includes("--loop")) {
    if (!(await readShift(vaultDir))) process.exit(0);
    try {
      await doSync(rest.filter((a) => a !== "--loop"));
    } catch (e) {
      await mkdir(join(vaultDir, "state"), { recursive: true });
      await appendFile(join(vaultDir, "state", "sync.log"), `${new Date().toISOString()} sync failed: ${e.message}\n`);
      await recordSyncFailure(vaultDir, { notifySyncFailing: () => notifySyncFailing() });
      process.exit(1);
    }
  } else if (command === "sync") {
    await doSync(rest);
  } else if (command === "start") {
    if (await readShift(vaultDir)) throw new Error("shift already started — run `kizuki stop` first");
    await startShift(vaultDir);
    await doSync([]);
    await installJob({ kizukiPath, vaultDir });
    console.log("\n" + (await renderBrief(vaultDir)));
  } else if (command === "stop") {
    if (!(await readShift(vaultDir))) throw new Error("no shift in progress");
    await doSync([]);
    const resolved = await resolveAgent(vaultDir);
    const summaryPath = await writeDaySummary(vaultDir, {
      runAgent: makeConfiguredRunAgent(resolved),
    });
    try {
      await removeJob({});
    } catch (e) {
      console.error(`warning: could not remove launchd job: ${e.message}`);
    }
    await endShift(vaultDir);
    await recordStop(vaultDir);
    console.log(`shift ended — day summary: ${summaryPath}`);
  } else if (command === "doctor") {
    const checkOnly = rest.includes("--check-only");
    const runSmoke = !rest.includes("--no-smoke");
    const MARKS = { pass: "✅", fail: "❌", skip: "⏭️" };
    let fails = 0;
    for await (const r of runDoctor(vaultDir, { makeConfiguredRunAgent, checkOnly, runSmoke })) {
      console.log(`${MARKS[r.status]} ${r.name} — ${r.detail}`);
      if (r.status === "fail") fails++;
    }
    console.log(fails ? `\n${fails} check(s) failed` : "\nall checks passed");
    process.exit(fails ? 1 : 0);
  } else if (command === "init") {
    const forceConfig = rest.includes("--force-config");
    const agentIdx = rest.indexOf("--agent");
    let agent;
    if (agentIdx !== -1) {
      agent = rest[agentIdx + 1];
      if (agent === undefined || agent.startsWith("--")) throw new Error("--agent requires a value");
    }
    const result = await runInit(vaultDir, { forceConfig, agent });
    console.log(formatInitReport({
      ...result,
      mcpServerPath: join(vaultDir, "mcp", "server.mjs"),
    }));
    const doctorFails = [];
    for await (const r of runDoctor(vaultDir, { makeConfiguredRunAgent, checkOnly: false, runSmoke: false })) {
      if (r.status === "fail") doctorFails.push(r.name);
    }
    if (doctorFails.length) console.log(`\nNote: doctor still reports: ${doctorFails.join(", ")}`);
  } else if (command === "signals") {
    console.log(await runSignalsCommand(vaultDir, rest));
  } else if (command === "signal") {
    console.log(await runSignalCommand(vaultDir, rest));
  } else if (command === "insights") {
    console.log(await runInsightsCommand(vaultDir, rest));
  } else if (command === "insight") {
    console.log(await runInsightCommand(vaultDir, rest));
  } else if (command === "catch") {
    console.log(await runCatchCommand(vaultDir, rest));
  } else if (command === "catches") {
    console.log(await runCatchesCommand(vaultDir, rest));
  } else if (command === "gate") {
    console.log(await runGateCommand(vaultDir, rest));
  } else if (command === "skills") {
    console.log(await runSkillsCommand(vaultDir, rest));
  } else if (command === "daemon") {
    console.log(await runDaemonCommand(vaultDir, repoDir, rest));
  } else if (command === "capture") {
    console.log(await runCaptureCommand(vaultDir, rest));
  } else if (command === "check") {
    const { scope, draftArg } = parseCheckArgs(rest);
    const draft = draftArg || (process.stdin.isTTY ? "" : (await readStdin()).trim());
    if (!draft) throw new Error('no draft provided — pass "<text>" or pipe via stdin');
    const resolved = await resolveAgent(vaultDir);
    const runAgent = resolved.kind === "http"
      ? makeConfiguredRunAgent(resolved)
      : makeRunCheckAgent(resolved.cmd, resolved.timeoutMs);
    const result = await runCheck({ draft, scope, vaultDir, runAgent });
    if (rest.includes("--json")) console.log(JSON.stringify(result, null, 2));
    else console.log(formatContradictions(result));
  } else if (command === "watch") {
    console.log(`Watching ${join(vaultDir, "transcripts")} — Ctrl+C to stop`);
    watchTranscripts(vaultDir, () => {
      doSync([]).catch((e) => console.error(`watch sync failed: ${e.message}`));
    });
  } else {
    console.error(USAGE);
    process.exit(1);
  }
} catch (e) {
  console.error(`kizuki ${command ?? ""} failed: ${e.message}`);
  process.exit(1);
}
