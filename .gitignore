node_modules/
.DS_Store

# Machine-specific agent config (which AI CLI to spawn)
kizuki.config.json

# Vault data — contains internal work info. Never commit/push.
# Keep the folder structure via .gitkeep, ignore the entity files themselves.
transcripts/*
!transcripts/.gitkeep
people/*
!people/.gitkeep
projects/*
!projects/.gitkeep
teams/*
!teams/.gitkeep

# Shift state + day summaries — machine-local work data
/state/
/days/
/alerts/
/signals/
/insights/
/catches/
/events/
/activity/

# SDD scratch (briefs, reports, review diffs, progress ledger)
.superpowers/

# Local agent memory — self-ignores via its own .gitignore, belt-and-braces here
.remember/

# npm pack output
*.tgz

# Next.js build output (web/)
web/.next/
web/next-env.d.ts
web/tsconfig.tsbuildinfo
.vercel/
.claude/*.local.md
.claude/settings.local.json

# Python analytics plane — local artifacts only.
# analytics/data/ holds warehouse.duckdb, whose contributor_identity table keeps
# raw author emails. It must never be pushed. The SQL cache is the one exception:
# it holds only questions and generated SQL, and CI needs it to run the eval
# suite with no model calls.
analytics/.venv/
analytics/data/*
!analytics/data/sqlcache/
analytics/.fastembed_cache/
analytics/**/__pycache__/
analytics/.pytest_cache/
analytics/.ruff_cache/
analytics/.python-version

# Backlog.md tracker — roadmap and forward strategy (billing, teams, hosted
# service, TEE). Same category as the docs the public export already strips.
/backlog/

# Vendored Claude skills. Third-party, regenerable, and large.
.claude/skills/

# Generated by `kizuki skills export --dist`. Built in CI and at release time
# rather than committed; the skills-export job proves the build is deterministic.
/dist/
