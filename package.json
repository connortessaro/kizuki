{
  "name": "kizuki",
  "version": "1.0.0",
  "type": "module",
  "description": "A study tool for your terminal. You teach, Kizuki plays the student, and every question quotes your own material.",
  "license": "Apache-2.0",
  "author": "Connor Tessaro",
  "homepage": "https://kizuki.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/connortessaro/kizuki.git"
  },
  "bugs": {
    "url": "https://github.com/connortessaro/kizuki/issues"
  },
  "keywords": [
    "study",
    "learning",
    "teach-back",
    "local-first",
    "ollama",
    "terminal",
    "tui"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "kizuki": "./bin/kizuki.mjs"
  },
  "files": [
    "bin/kizuki.mjs",
    "dist/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "node scripts/build.mjs && node bin/kizuki.mjs",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "qc": "pnpm lint && pnpm typecheck && pnpm docs:check && pnpm coverage && pnpm check:pii && pnpm audit --prod --audit-level high",
    "eval": "evalite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "docs": "typedoc",
    "check:pii": "node scripts/check-pii.mjs",
    "prepack": "node scripts/build.mjs",
    "eval:summary": "node scripts/eval-summary.mjs",
    "docs:check": "typedoc --emit none",
    "docs:site": "typedoc"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.55",
    "ai": "^7.0.113",
    "better-sqlite3": "^13.0.3",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "sqlite-vec": "^0.1.9",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "evalite": "^0.19.0",
    "globals": "^17.12.0",
    "ink-testing-library": "^4.0.0",
    "typedoc": "^0.28.20",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.34.6"
}
